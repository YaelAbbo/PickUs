# App
APP_NAME=PickUs
NODE_ENV=development

# Backend
BACKEND_PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:8081
JWT_ACCESS_SECRET=jwt-access-secret
JWT_REFRESH_SECRET=jwt-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10
REFRESH_TOKEN_COOKIE_KEY=refreshToken
DB_LOGGING=true

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pickus_user
POSTGRES_PASSWORD=pickus_secret
POSTGRES_DB=pickus_db

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@pickus.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=8080

# Frontend
# Replace X.X.X.X with your computer's actual local IP address
REACT_NATIVE_PACKAGER_HOSTNAME=X.X.X.X
EXPO_PUBLIC_API_URL=http://X.X.X.X/api
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
