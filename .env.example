# App
APP_NAME=PickUs
NODE_ENV=development

# Backend
BACKEND_PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost
JWT_ACCESS_SECRET=jwt-access-secret
JWT_REFRESH_SECRET=jwt-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10
REFRESH_TOKEN_COOKIE_KEY=refreshToken
DB_LOGGING=true

# Temporary Password Logic (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set SMTP_SECURE=true only when using port 465 (implicit TLS)
SMTP_SECURE=false
SMTP_USER=pickus.app@gmail.com
SMTP_PASS=your-smtp-password
SMTP_FROM=pickus.app@gmail.com

# Database
# If you want to run the backend without Docker
# Uncomment the following line and set DB_HOST to localhost
# DB_HOST=localhost 
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pickus

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@pickus.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=8080

# Frontend
# Replace X.X.X.X with your computer's actual local IP address
REACT_NATIVE_PACKAGER_HOSTNAME=X.X.X.X
EXPO_PUBLIC_API_URL=http://X.X.X.X/api
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
